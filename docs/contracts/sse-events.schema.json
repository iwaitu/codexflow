        "error",
        "done",
        "replay_gap",
        "business_skill_run_updated",
        "business_skill_approval_requested",
        "business_skill_approval_resolved",
        "plan_mode_changed",
        "plan_mode_exit_requested",
        "browser_state_updated",
        "browser_approval_requested",
        "browser_approval_resolved"
      ]
