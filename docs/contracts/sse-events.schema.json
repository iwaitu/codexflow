  "$defs": {
    "heartbeat": {
      "type": "object",
      "description": "Periodic heartbeat and connection handshake.",
      "additionalProperties": true,
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "connected",
            "alive"
          ]
        },
        "subscriberCount": {
          "type": "integer"
        },
        "epoch": {
          "type": [
            "string",
            "null"
          ]
        },
        "intervalSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "pendingApprovals": {
          "type": "integer"
        }
      },
      "required": [
        "sessionId",
        "status",
        "subscriberCount",
        "pendingApprovals"
      ]
    },
    "content": {
      "type": "object",
      "description": "Assistant visible response text delta.",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "content"
        },
        "content": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "content",
        "text"
      ]
    },
    "thinking_start": {
      "type": "object",
      "description": "Marks start of assistant reasoning block.",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "thinking_start"
        }
      },
      "required": [
        "type"
      ]
    },
    "thinking_content": {
      "type": "object",
      "description": "Assistant reasoning text delta.",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "thinking_content"
        },
        "content": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "content",
        "text"
      ]
    },
    "thinking_end": {
      "type": "object",
      "description": "Marks end of assistant reasoning block.",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "thinking_end"
        },
        "thinking_content": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "thinking_content"
      ]
    },
    "tool_call": {
      "type": "object",
      "description": "Model requested a tool invocation (arguments sanitized and bounded).",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "tool_call"
        },
        "name": {
          "type": "string"
        },
        "callId": {
          "type": [
            "string",
            "null"
          ]
        },
        "arguments": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "argumentsTruncated": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    "tool_started": {
      "type": "object",
      "description": "Tool execution started on the host.",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "tool_started"
        },
        "name": {
          "type": "string"
        },
        "callId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    "tool_output": {
      "type": "object",
      "description": "Throttled stdout/stderr stream chunk from an executing command tool.",
      "additionalProperties": true,
      "properties": {
        "tool": {
          "type": "string"
        },
        "commandTaskId": {
          "type": "string"
        },
        "stdout": {
          "type": [
            "string",
            "null"
          ]
        },
        "stderr": {
          "type": [
            "string",
            "null"
          ]
        },
        "throttled": {
          "type": "boolean"
        },
        "suppressedLines": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "tool",
        "commandTaskId",
        "throttled"
      ]
    },
    "tool_approval_request": {
      "type": "object",
      "description": "Interactive approval request before starting untrusted code execution.",
      "additionalProperties": true,
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "requestDigest": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "interpreterChain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "stdinSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "codeSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "scriptSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "filesystem": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string"
        },
        "allowedDecisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executesWorkspaceCode": {
          "type": "boolean"
        },
        "trustedOriginVerified": {
          "type": "boolean"
        },
        "selfApprovalProtection": {
          "type": "boolean"
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "policyVersion": {
          "type": [
            "integer",
            "null"
          ]
        },
        "wrapperSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "exportScopeSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeoutSeconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "imageDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "shellKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "shell": {
          "type": [
            "string",
            "null"
          ]
        },
        "scriptPreview": {
          "type": [
            "string",
            "null"
          ]
        },
        "scriptLength": {
          "type": [
            "integer",
            "null"
          ]
        },
        "backendNotice": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "approvalId",
        "requestDigest",
        "sessionId",
        "tool",
        "executable",
        "interpreterChain",
        "argv",
        "cwd",
        "backend",
        "network",
        "filesystem",
        "reason",
        "expiresAt",
        "allowedDecisions",
        "executesWorkspaceCode",
        "trustedOriginVerified",
        "selfApprovalProtection"
      ]
    },
    "tool_approval_resolved": {
      "type": "object",
      "description": "Resolution outcome for a pending tool approval request.",
      "additionalProperties": true,
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "requestDigest": {
          "type": "string"
        },
        "sessionId": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "decidedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolvedAt": {
          "type": "string"
        }
      },
      "required": [
        "approvalId",
        "requestDigest",
        "sessionId",
        "decision",
        "resolvedAt"
      ]
    },
    "task_status": {
      "type": "object",
      "description": "Tool completion or task-status progress update.",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "callId": {
          "type": [
            "string",
            "null"
          ]
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ]
    },
    "setconversationid": {
      "type": "object",
      "description": "Binds the active conversation identifier for this turn.",
      "additionalProperties": true,
      "properties": {
        "conversationId": {
          "type": "string"
        }
      },
      "required": [
        "conversationId"
      ]
    },
    "updateconversationtitle": {
      "type": "object",
      "description": "Updates the conversation display title.",
      "additionalProperties": true,
      "properties": {
        "conversationId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "conversationId",
        "title"
      ]
    },
    "system_message": {
      "type": "object",
      "description": "Host system notification message.",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "noticeType": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "string"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content"
      ]
    },
    "next_task_started": {
      "type": "object",
      "description": "Background plan task dispatch notification.",
      "additionalProperties": true,
      "properties": {
        "taskId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "jobType": {
          "type": "string"
        },
        "workerType": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "taskId",
        "title",
        "jobId",
        "jobType"
      ]
    },
    "retry_notice": {
      "type": "object",
      "description": "Task failure automatic retry scheduled.",
      "additionalProperties": true,
      "properties": {
        "taskId": {
          "type": "string"
        },
        "retryCount": {
          "type": "integer"
        },
        "maxRetries": {
          "type": "integer"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "taskId",
        "retryCount",
        "maxRetries"
      ]
    },
    "plan_change_request": {
      "type": "object",
      "description": "Plan requires adjustment after exhausted retries or failure.",
      "additionalProperties": true,
      "properties": {
        "taskId": {
          "type": "string"
        },
        "failureCount": {
          "type": "integer"
        },
        "maxRetries": {
          "type": "integer"
        },
        "canRetry": {
          "type": "boolean"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "taskId",
        "failureCount",
        "maxRetries",
        "canRetry"
      ]
    },
    "plan_approval_requested": {
      "type": "object",
      "description": "Plan artifact transitioned to ReadyForApproval and awaits user confirmation.",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "plan_approval_requested"
        },
        "planArtifactId": {
          "type": "string"
