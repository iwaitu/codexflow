<Project>
  <Target Name="PrepareNativeAotDependencyInputs"
          AfterTargets="ComputeIlcCompileInputs"
          Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <_NativeAotDependencyDirectory>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)native-aot-dependencies', '$(MSBuildProjectDirectory)'))</_NativeAotDependencyDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_NativeAotOriginalExcel Include="@(IlcReference)" Condition="'%(IlcReference.Filename)' == 'ExcelDataReader'" />
      <_NativeAotOriginalJson Include="@(IlcReference)" Condition="'%(IlcReference.Filename)' == 'Newtonsoft.Json'" />
    </ItemGroup>
    <Error Condition="'@(_NativeAotOriginalExcel->Count())' != '1' or '@(_NativeAotOriginalJson->Count())' != '1'"
           Text="Native AOT requires exactly one resolved ExcelDataReader and one resolved Newtonsoft.Json assembly." />

    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy RemoteSigned -File &quot;$(MSBuildThisFileDirectory)NativeAotDependencies\Build.ps1&quot; -OutputDirectory &quot;$(_NativeAotDependencyDirectory)&quot; -ExcelAssembly &quot;@(_NativeAotOriginalExcel->'%(FullPath)')&quot; -NewtonsoftAssembly &quot;@(_NativeAotOriginalJson->'%(FullPath)')&quot;" />

    <ItemGroup>
      <_NativeAotPatchedDependency Include="$(_NativeAotDependencyDirectory)/ExcelDataReader.dll;$(_NativeAotDependencyDirectory)/Newtonsoft.Json.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_NativeAotPatchedDependency.Identity)')"
           Text="The Native AOT dependency build did not produce %(_NativeAotPatchedDependency.Identity)." />

    <ItemGroup>
      <IlcReference Remove="@(_NativeAotOriginalExcel);@(_NativeAotOriginalJson)" />
      <IlcReference Include="@(_NativeAotPatchedDependency)" />
    </ItemGroup>
  </Target>

  <Target Name="PublishNativeAotDependencyLicenses"
          AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <_NativeAotDependencyLicense Include="$(_NativeAotDependencyDirectory)/ExcelDataReader.LICENSE.txt;$(_NativeAotDependencyDirectory)/Newtonsoft.Json.LICENSE.txt" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeAotDependencyLicense)" DestinationFolder="$(PublishDir)/third-party-licenses" SkipUnchangedFiles="true" />
  </Target>
</Project>
