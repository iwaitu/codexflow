<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CodexFlow.Gateway.Http</PackageId>
    <Description>The HTTP surface of the CodexFlow gateway, including chat, the event stream, jobs and artifact verification.</Description>
  </PropertyGroup>

  <!-- The HTTP surface of the gateway: chat, the event stream, jobs and artifact verification. Hosts map the same routes;
       each host decides who the "Bearer" caller is and what the "ActiveUser" policy means. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplies the name of the Bearer authentication scheme used by the endpoints. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexFlow.Orchestration\CodexFlow.Orchestration.csproj" />
  </ItemGroup>

</Project>
