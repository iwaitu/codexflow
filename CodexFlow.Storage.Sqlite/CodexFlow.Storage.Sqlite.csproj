<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CodexFlow.Storage.Sqlite</PackageId>
    <Description>CodexFlow state in one SQLite file: jobs, plans, sessions, conversations, the job event history and an expiring key-value store.</Description>
  </PropertyGroup>

  <!-- State of the local host in one SQLite file: jobs, plans, sessions, conversations, the job event history and an expiring
       key-value store. Depends on CodexFlow.Orchestration only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="SchemaMigrations/*.sql" LogicalName="CodexFlow.Storage.Sqlite.SchemaMigrations.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexFlow.Orchestration\CodexFlow.Orchestration.csproj" />
    <InternalsVisibleTo Include="CodexFlow.Storage.Sqlite.Design" />
  </ItemGroup>

</Project>
