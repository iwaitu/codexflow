<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CodexFlow.Orchestration</PackageId>
    <Description>The part of CodexFlow a host runs: the gateway, the background job runner and the host-side acceptance of a result.</Description>
  </PropertyGroup>

  <!-- The part of CodexFlow that a host runs: gateway, job runner and host-side acceptance. It depends on CodexFlow.Core and
       CodexFlow.Contracts only, never on a database server, a user system or a web framework, so the local host and the platform host
       can both build on it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true' Or '$(PublishTrimmed)' == 'true' Or '$(IsTrimmable)' == 'true' Or '$(IsAotCompatible)' == 'true' Or '$(EnableTrimAnalyzer)' == 'true' Or '$(EnableAotAnalyzer)' == 'true'">
    <DefineConstants>$(DefineConstants);CODEXFLOW_CLOSED_PAYLOADS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="Ulid" Version="1.4.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexFlow.Core\CodexFlow.Core.csproj" />
    <ProjectReference Include="..\CodexFlow.Contracts\CodexFlow.Contracts.csproj" />
  </ItemGroup>

  <!-- The namespaces the web SDK imports implicitly; this code was written inside the web host and relies on them. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodexFlow" />
    <InternalsVisibleTo Include="CodexFlow.Gateway.Http" />
    <InternalsVisibleTo Include="CodexFlow.Storage.Sqlite" />
    <InternalsVisibleTo Include="CodexFlow.Storage.EntityFramework" />
    <InternalsVisibleTo Include="CodexFlow.Storage.Sqlite.Design" />
    <InternalsVisibleTo Include="CodexFlow.Local" />
    <InternalsVisibleTo Include="CodexFlow.Tests" />
    <InternalsVisibleTo Include="CodexFlow.Core.Tests" />
    <InternalsVisibleTo Include="CodexFlow.Gateway.IntegrationTests" />
    <InternalsVisibleTo Include="CodexFlow.BackgroundJbobRunner.IntergrationTests" />
  </ItemGroup>

</Project>
