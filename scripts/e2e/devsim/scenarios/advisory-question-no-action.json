{
  "name": "advisory-question-no-action",
  "description": "A question about dependency vulnerabilities, with 'do not change code', must be answered without starting any work.",
  "repo": "https://github.com/iwaitu/cleanapp-bug.git",
  "steps": [
    {
      "name": "clone the project",
      "say": "把这个项目拉下来：https://github.com/iwaitu/cleanapp-bug.git",
      "repo": true,
      "timeout_min": 8,
      "expect": {
        "reply_not_empty": true,
        "jobs": {
          "none": true
        }
      }
    },
    {
      "name": "ask about vulnerabilities",
      "say": "这个项目的 NuGet 依赖有没有已知的安全漏洞？有的话给我一个升级方案，哪些能直接升，哪些要我拍板。先别改代码。",
      "timeout_min": 10,
      "expect": {
        "reply_not_empty": true,
        "tools_exclude": [
          "approve_plan",
          "start_next_task",
          "create_session_plan"
        ],
        "jobs": {
          "none": true
        }
      }
    }
  ]
}
