<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Not part of CodexFlow.slnx. The release pipeline packs the six libraries, then restores them from the packed folder (plus nuget.org for what
       they depend on) into this project and exercises the public APIs using only the installed packages. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CodexFlow.Storage.Sqlite" Version="$(CodexFlowVersion)" />
    <PackageReference Include="CodexFlow.Storage.EntityFramework" Version="$(CodexFlowVersion)" />
    <PackageReference Include="CodexFlow.Gateway.Http" Version="$(CodexFlowVersion)" />
  </ItemGroup>

</Project>
