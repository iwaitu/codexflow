<?xml version="1.0" encoding="utf-8"?>
<!-- The five CodexFlow packages come ONLY from the folder in CODEXFLOW_PACKED (the freshly packed ones); everything else, including
     CodexFlow.QueryRuntime.Engine, comes from nuget.org. Without the mapping a version that is already published could be restored from nuget.org
     and the check would prove nothing about what was just packed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="packed" value="%CODEXFLOW_PACKED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed">
      <package pattern="CodexFlow.Contracts" />
      <package pattern="CodexFlow.Core" />
      <package pattern="CodexFlow.Orchestration" />
      <package pattern="CodexFlow.Gateway.Http" />
      <package pattern="CodexFlow.Storage.Sqlite" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
