<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VllmChatClient" Version="2.0.40" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.35" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SharpToken" Version="2.0.6" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexFlow.Core\CodexFlow.Core.csproj" />
    <ProjectReference Include="..\CodexFlow.Contracts\CodexFlow.Contracts.csproj" />
    <ProjectReference Include="..\CodexFlow.Local\CodexFlow.Local.csproj" />
    <ProjectReference Include="..\CodexFlow.Storage.Sqlite.Design\CodexFlow.Storage.Sqlite.Design.csproj" />
  </ItemGroup>

</Project>
